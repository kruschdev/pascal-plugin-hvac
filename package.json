{
  "name": "@kruschdev/pascal-plugin-hvac",
  "version": "0.2.0",
  "description": "Residential & Light-Commercial IMC/UMC/ACCA Manual J/D/S & ASHRAE 62.2 HVAC authoring, duct & refrigerant lineset routing, IECC envelope takeoff, and code audit plugin for Pascal Editor.",
  "author": "Kevin Ruschman <kruschdev@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruschdev/pascal-plugin-hvac.git"
  },
  "homepage": "https://github.com/kruschdev/pascal-plugin-hvac",
  "bugs": {
    "url": "https://github.com/kruschdev/pascal-plugin-hvac/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render.ts",
    "./imc": "./src/imc/index.ts",
    "./cad": "./src/cad/index.ts",
    "./agent-tools": "./src/agent-tools.ts",
    "./agent-operations": "./src/agent-operations.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/__tests__",
    "docs/ARCHITECTURE.md",
    "docs/IMC-REFERENCE.md",
    "docs/AGENT-TOOLS.md",
    "docs/CAD-CATALOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "NODE_ENV=production bun scripts/build-dist.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test src",
    "check:render": "bun scripts/check-render-entry.ts",
    "export:cad": "bun scripts/export-cad-catalog.ts",
    "render:cad-thumbs": "bun scripts/render-cad-thumbnails.ts",
    "render:cutaway": "bun scripts/render-air-handler-cutaway.ts",
    "render:walkthrough": "bun scripts/render-walkthrough-video.ts",
    "render:social": "bun scripts/render-social-preview.ts",
    "check": "bun run check-types && bun test && bun run check:render && bun run build"
  },
  "dependencies": {
    "@kruschdev/pascal-mep-kernel": "^0.1.0"
  },
  "peerDependencies": {
    "@pascal-app/core": ">=1.0.0 <2",
    "@pascal-app/editor": ">=1.0.0 <2",
    "@pascal-app/viewer": ">=1.0.0 <2",
    "react": "^18 || ^19",
    "three": ">=0.185 <1",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@pascal-app/core": "1.1.6",
    "@pascal-app/editor": "1.1.6",
    "@pascal-app/viewer": "1.1.6",
    "@types/blob-stream": "^0.1.33",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.19.12",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "keywords": [
    "pascal",
    "pascal-plugin",
    "hvac",
    "imc",
    "umc",
    "manual-j",
    "manual-d",
    "ashrae",
    "iecc",
    "ductwork",
    "heat-pump",
    "mep",
    "bim",
    "aeco",
    "3d",
    "cad"
  ]
}
